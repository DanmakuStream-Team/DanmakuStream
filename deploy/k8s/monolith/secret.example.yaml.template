# 模板文件：复制为 secret.yaml 后填入真实值；secret.yaml 已加入 .gitignore。
# DATABASE_DSN 与 DB_PASSWORD 必须使用相同密码。
# kubectl apply -f deploy/k8s/monolith/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: danmakustream-secrets
  namespace: danmakustream
type: Opaque
stringData:
  DB_PASSWORD: "replace-with-real-password"
  JWT_SECRET: "replace-with-real-jwt-secret"
  DATABASE_DSN: "root:replace-with-real-password@tcp(mysql:3306)/danmakustream?charset=utf8mb4&parseTime=True&loc=Local"
