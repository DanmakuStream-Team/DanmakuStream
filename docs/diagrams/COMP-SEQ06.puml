@startuml COMP-SEQ06
skinparam sequence {
    ArrowColor #2c3e50
    ActorBorderColor #2c3e50
    LifeLineBorderColor #2c3e50
    ParticipantBorderColor #34495e
    ParticipantBackgroundColor #ecf0f1
    BoxBorderColor #95a5a6
    BoxBackgroundColor #f8f9fa
}

box "engagement-service 内部组件" #e8f5e9
    participant "HistoryService\n历史记录服务" as HistorySvc
    participant "ProgressService\n播放进度服务" as ProgressSvc
    participant "WatchLaterService\n稍后再看服务" as WatchLaterSvc
    participant "LikeService\n点赞服务" as LikeSvc
    participant "CollectService\n收藏服务" as CollectSvc
end box

box "Repository 数据访问层" #fff3e0
    participant "HistoryRepository\n历史记录仓储" as HistoryRepo
    participant "ProgressRepository\n进度仓储" as ProgressRepo
    participant "WatchLaterRepository\n稍后再看仓储" as WatchLaterRepo
    participant "LikeRepository\n点赞仓储" as LikeRepo
    participant "CollectRepository\n收藏仓储" as CollectRepo
end box

box "MySQL 数据库 (engagement_schema)" #e3f2fd
    database "history_records" as HistoryDB
    database "play_progress" as ProgressDB
    database "watch_later" as WatchLaterDB
    database "likes" as LikeDB
    database "collects" as CollectDB
end box

autonumber

== 场景一：查看历史记录列表 ==
participant "EngagementController\nAPI入口" as Controller

note over Controller
  // TODO: 代码中未找到 HistoryController
  后端UC06 API尚未实现，以下为设计层面组件图
end note

Controller -> HistorySvc: getHistoryList(userId, page, pageSize)
activate HistorySvc
    HistorySvc -> HistoryRepo: findByUserId(userId, page, pageSize)
    activate HistoryRepo
        HistoryRepo -> HistoryDB: SELECT * FROM history_records\nWHERE user_id = ?\nORDER BY saved_at DESC\nLIMIT ?, ?
        HistoryDB --> HistoryRepo: 返回记录列表 + Video关联
    deactivate HistoryRepo
    HistoryRepo --> HistorySvc: List<HistoryRecord>
deactivate HistorySvc
HistorySvc --> Controller: PageResult<HistoryRecordVO>

== 场景二：保存/更新播放进度 ==
Controller -> ProgressSvc: upsertProgress(userId, videoId, progress)
activate ProgressSvc
    ProgressSvc -> ProgressRepo: findOne(userId, videoId)
    activate ProgressRepo
        ProgressRepo -> ProgressDB: SELECT * FROM play_progress\nWHERE user_id = ? AND video_id = ?
        alt 记录已存在
            ProgressDB --> ProgressRepo: 返回已有记录
            ProgressRepo --> ProgressSvc: ProgressRecord
        else 记录不存在
            ProgressDB --> ProgressRepo: gorm.ErrRecordNotFound
            ProgressRepo --> ProgressSvc: nil
        end
    deactivate ProgressRepo

    alt 记录已存在
        ProgressSvc -> ProgressRepo: update(userId, videoId, progress, savedAt)
        activate ProgressRepo
            ProgressRepo -> ProgressDB: UPDATE play_progress\nSET progress = ?, saved_at = NOW()\nWHERE user_id = ? AND video_id = ?
            ProgressDB --> ProgressRepo: RowsAffected
        deactivate ProgressRepo
    else 新建记录
        ProgressSvc -> ProgressRepo: create(ProgressRecord)
        activate ProgressRepo
            ProgressRepo -> ProgressDB: INSERT INTO play_progress\n(user_id, video_id, progress, saved_at)\nVALUES (?, ?, ?, NOW())
            ProgressDB --> ProgressRepo: LastInsertID
        deactivate ProgressRepo
    end

    ' 同时更新历史记录中的进度字段
    ProgressSvc -> HistoryRepo: upsertHistory(userId, videoId, progress)
    activate HistoryRepo
        HistoryRepo -> HistoryDB: INSERT INTO history_records\n(user_id, video_id, saved_at, progress)\nVALUES (?, ?, NOW(), ?)\nON DUPLICATE KEY UPDATE\nprogress = VALUES(progress),\nsaved_at = NOW()
        HistoryDB --> HistoryRepo: 执行结果
    deactivate HistoryRepo
deactivate ProgressSvc
ProgressSvc --> Controller: { ok: true }

== 场景三：添加到稍后再看 ==
Controller -> WatchLaterSvc: addToWatchLater(userId, videoId)
activate WatchLaterSvc
    WatchLaterSvc -> WatchLaterRepo: exists(userId, videoId)
    activate WatchLaterRepo
        WatchLaterRepo -> WatchLaterDB: SELECT COUNT(1) FROM watch_later\nWHERE user_id = ? AND video_id = ?
        WatchLaterDB --> WatchLaterRepo: count
    deactivate WatchLaterRepo
    WatchLaterRepo --> WatchLaterSvc: bool exists

    alt 已存在
        WatchLaterSvc --> Controller: { added: false, msg: "已在稍后再看列表中" }
    else 不存在
        WatchLaterSvc -> WatchLaterRepo: create(WatchLaterRecord)
        activate WatchLaterRepo
            WatchLaterRepo -> WatchLaterDB: INSERT INTO watch_later\n(user_id, video_id, added_at)\nVALUES (?, ?, NOW())
            WatchLaterDB --> WatchLaterRepo: LastInsertID
        deactivate WatchLaterRepo
        WatchLaterSvc --> Controller: { added: true }
    end
deactivate WatchLaterSvc

== 场景四：从稍后再看移除 ==
Controller -> WatchLaterSvc: removeFromWatchLater(userId, videoId)
activate WatchLaterSvc
    WatchLaterSvc -> WatchLaterRepo: delete(userId, videoId)
    activate WatchLaterRepo
        WatchLaterRepo -> WatchLaterDB: DELETE FROM watch_later\nWHERE user_id = ? AND video_id = ?
        WatchLaterDB --> WatchLaterRepo: RowsAffected
    deactivate WatchLaterRepo
    WatchLaterRepo --> WatchLaterSvc: rowsAffected
    alt rowsAffected > 0
        WatchLaterSvc --> Controller: { removed: true }
    else rowsAffected = 0
        WatchLaterSvc --> Controller: { removed: false, msg: "记录不存在" }
    end
deactivate WatchLaterSvc

== 场景五：清空历史记录 ==
Controller -> HistorySvc: clearAllHistory(userId)
activate HistorySvc
    HistorySvc -> HistoryRepo: deleteAllByUserId(userId)
    activate HistoryRepo
        HistoryRepo -> HistoryDB: DELETE FROM history_records\nWHERE user_id = ?
        HistoryDB --> HistoryRepo: RowsAffected
    deactivate HistoryRepo
    HistoryRepo --> HistorySvc: deletedCount

    ' 同时清空关联的播放进度
    HistorySvc -> ProgressRepo: deleteAllByUserId(userId)
    activate ProgressRepo
        ProgressRepo -> ProgressDB: DELETE FROM play_progress\nWHERE user_id = ?
        ProgressDB --> ProgressRepo: RowsAffected
    deactivate ProgressRepo
deactivate HistorySvc
HistorySvc --> Controller: { deleted: deletedCount }

== 场景六：点赞视频（后端真实实现路径） ==
note over Controller, LikeSvc
  以下点赞流程为代码中已真实实现的组件调用
end note

participant "video_handler\nVideoHandler.LikeHandler" as LikeHandler
LikeHandler -> LikeSvc: toggleLike(userId, videoId)
activate LikeSvc
    LikeSvc -> LikeRepo: findByUserAndVideo(userId, videoId)
    activate LikeRepo
        LikeRepo -> LikeDB: SELECT * FROM likes\nWHERE user_id = ? AND video_id = ?
        alt 已存在
            LikeDB --> LikeRepo: Like实体
            LikeRepo --> LikeSvc: existingLike
        else 不存在
            LikeDB --> LikeRepo: ErrRecordNotFound
            LikeRepo --> LikeSvc: nil
        end
    deactivate LikeRepo

    alt 取消点赞
        LikeSvc -> LikeRepo: delete(existingLike)
        activate LikeRepo
            LikeRepo -> LikeDB: DELETE FROM likes WHERE id = ?
            LikeDB --> LikeRepo: ok
        deactivate LikeRepo
        LikeSvc -> LikeRepo: decrementVideoLikeCount(videoId)
        activate LikeRepo
            LikeRepo -> LikeDB: UPDATE videos SET like_count = like_count - 1\nWHERE id = ? AND like_count > 0
            LikeDB --> LikeRepo: ok
        deactivate LikeRepo
        LikeSvc --> LikeHandler: { liked: false }
    else 新增点赞
        LikeSvc -> LikeRepo: create(user_id=userId, video_id=videoId)
        activate LikeRepo
            LikeRepo -> LikeDB: INSERT INTO likes (user_id, video_id) VALUES (?, ?)
            LikeDB --> LikeRepo: ok
        deactivate LikeRepo
        LikeSvc -> LikeRepo: incrementVideoLikeCount(videoId)
        activate LikeRepo
            LikeRepo -> LikeDB: UPDATE videos SET like_count = like_count + 1 WHERE id = ?
            LikeDB --> LikeRepo: ok
        deactivate LikeRepo
        LikeSvc --> LikeHandler: { liked: true }
    end
deactivate LikeSvc

@enduml
