@startuml OBJ-SEQ06
skinparam sequence {
    ArrowColor #2c3e50
    ActorBorderColor #2c3e50
    LifeLineBorderColor #2c3e50
    ParticipantBorderColor #34495e
    ParticipantBackgroundColor #ecf0f1
    BoxBorderColor #95a5a6
    BoxBackgroundColor #f8f9fa
}

box "Controller 层 (Gin Handlers)" #e3f2fd
    participant "UserLibraryHandler\n(Controller)" as Controller
end box

box "Service 层 (Business Logic)" #e8f5e9
    participant "HistoryService" as HistorySvc
    participant "ProgressService" as ProgressSvc
    participant "WatchLaterService" as WLSvc
    participant "LikeHandler (已实现)" as LikeHandlerObj
end box

box "Repository 层 (GORM DAO)" #fff3e0
    participant "HistoryRepository" as HistoryRepo
    participant "ProgressRepository" as ProgressRepo
    participant "WatchLaterRepository" as WLRepo
    participant "LikeRepository" as LikeRepo
end box

box "GORM / MySQL (engagement_schema)" #fce4ec
    database "*gorm.DB (Pool)" as DB
end box

note left of Controller
  [方法签名]
  + GetHistory(userId uint, page int)
  + SaveProgress(userId, videoId uint, progress int)
  + AddWatchLater(userId, videoId uint)
  + RemoveWatchLater(userId, videoId uint)
  + ClearHistory(userId uint)
end note

note left of HistorySvc
  [方法签名]
  + ListHistory(userId, page, size int): PageResult
  + ClearHistory(userId uint): int64
end note

note left of ProgressSvc
  [方法签名]
  + Upsert(userId, videoId uint, progress int): error
  + Get(userId, videoId uint): *ProgressRecord
end note

note left of WLSvc
  [方法签名]
  + Add(userId, videoId uint): bool
  + Remove(userId, videoId uint): bool
  + List(userId, page, size int): PageResult
end note

note left of HistoryRepo
  [方法签名]
  + FindByUser(userId, offset, limit int): []HistoryRecord
  + CountByUser(userId uint): int64
  + DeleteAll(userId uint): int64
  + Upsert(rec *HistoryRecord): error
end note

note left of LikeRepo
  [方法签名]
  + FindOne(userId, videoId uint): *model.Like
  + Create(like *model.Like): error
  + Delete(like *model.Like): error
  + IncrVideoLikes(videoId uint): error
  + DecrVideoLikes(videoId uint): error
end note

autonumber

== 路径1：Controller -> HistoryService -> HistoryRepository -> DB（查看历史） ==

Controller -> HistorySvc : ListHistory(userId=1001, page=1, size=20)
activate HistorySvc
    HistorySvc -> HistoryRepo : CountByUser(userId=1001)
    activate HistoryRepo
        HistoryRepo -> DB : Model(&HistoryRecord{}).Where("user_id=?", 1001).Count(&total)
        DB --> HistoryRepo : total = 42
    deactivate HistoryRepo
    HistoryRepo --> HistorySvc : int64(42)

    HistorySvc -> HistoryRepo : FindByUser(userId=1001, offset=0, limit=20)
    activate HistoryRepo
        HistoryRepo -> DB : Preload("Video").Preload("Video.Author")\n.Where("user_id=?", 1001).Order("saved_at DESC")\n.Offset(0).Limit(20).Find(&records)
        DB --> HistoryRepo : []HistoryRecord (length=20)
    deactivate HistoryRepo
    HistoryRepo --> HistorySvc : []HistoryRecord
deactivate HistorySvc
HistorySvc --> Controller : PageResult{List:[...], Total:42, Page:1, PageSize:20}

== 路径2：Controller -> ProgressService -> ProgressRepository -> DB（保存进度） ==

Controller -> ProgressSvc : Upsert(userId=1001, videoId=50, progress=65)
activate ProgressSvc
    ProgressSvc -> ProgressRepo : Find(userId=1001, videoId=50)
    activate ProgressRepo
        ProgressRepo -> DB : Where("user_id=? AND video_id=?", 1001,50).First(&rec)
        alt 记录存在
            DB --> ProgressRepo : &ProgressRecord{Progress:30}
        else 记录不存在
            DB --> ProgressRepo : gorm.ErrRecordNotFound
        end
    deactivate ProgressRepo
    ProgressRepo --> ProgressSvc : *ProgressRecord

    alt 记录存在 -> 更新
        ProgressSvc -> ProgressRepo : Update(&ProgressRecord{Progress:65, SavedAt:now})
        activate ProgressRepo
            ProgressRepo -> DB : Model(&rec).Updates(progress,saved_at)
            DB --> ProgressRepo : RowsAffected=1
        deactivate ProgressRepo
    else 记录不存在 -> 创建
        ProgressSvc -> ProgressRepo : Create(&ProgressRecord{UserID:1001, VideoID:50, Progress:65})
        activate ProgressRepo
            ProgressRepo -> DB : Create(&ProgressRecord{...})
            DB --> ProgressRepo : LastInsertID
        deactivate ProgressRepo
    end

    ProgressSvc -> HistoryRepo : Upsert(&HistoryRecord{UserID:1001, VideoID:50, Progress:65})
    activate HistoryRepo
        HistoryRepo -> DB : Exec(INSERT INTO history_records ... ON DUPLICATE KEY UPDATE)
        DB --> HistoryRepo : 执行成功
    deactivate HistoryRepo
deactivate ProgressSvc
ProgressSvc --> Controller : { success: true }

