== 路径4：LikeHandler (代码真实实现路径，对应video_handler.go LikeHandler) ==

note over LikeHandlerObj, LikeRepo
  以下流程为 video_handler.go 中 LikeHandler
  的真实执行路径（svcCtx.DB.Transaction）
end note

participant "svcCtx.DB (Tx)" as TxDB #ffecb3

LikeHandlerObj -> LikeRepo : FindOne(userId=1001, videoId=50)
activate LikeRepo
    LikeRepo -> TxDB : Where("user_id=? AND video_id=?", 1001, 50).First(&like)
    alt 已点赞（取消）
        TxDB --> LikeRepo : &model.Like{ID: 88}
    else 未点赞（新增）
        TxDB --> LikeRepo : gorm.ErrRecordNotFound
    end
deactivate LikeRepo
LikeRepo --> LikeHandlerObj : *model.Like

alt 取消点赞
    LikeHandlerObj -> LikeRepo : Delete(&like)
    activate LikeRepo
        LikeRepo -> TxDB : Unscoped().Delete(&like)
        TxDB --> LikeRepo : ok
    deactivate LikeRepo

    LikeHandlerObj -> LikeRepo : DecrVideoLikes(videoId=50)
    activate LikeRepo
        LikeRepo -> TxDB : Model(&model.Video{}).Where("id=?",50)\n.UpdateColumn("like_count", like_count - 1)
        TxDB --> LikeRepo : ok
    deactivate LikeRepo
    LikeHandlerObj --> TxDB : commit; return {liked:false}
else 新增点赞
    LikeHandlerObj -> LikeRepo : Create(&model.Like{UserID:1001, VideoID:50})
    activate LikeRepo
        LikeRepo -> TxDB : Create(&model.Like{UserID:1001, VideoID:50})
        TxDB --> LikeRepo : ID=89
    deactivate LikeRepo

    LikeHandlerObj -> LikeRepo : IncrVideoLikes(videoId=50)
    activate LikeRepo
        LikeRepo -> TxDB : Model(&model.Video{}).Where("id=?",50)\n.UpdateColumn("like_count", like_count + 1)
        TxDB --> LikeRepo : ok
    deactivate LikeRepo
    LikeHandlerObj --> TxDB : commit; return {liked:true}
end

@enduml
