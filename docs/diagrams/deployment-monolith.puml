' 项目：DanmakuStream
' 版本：v1.0
' 作者：E
' 日期：2026-08-26
' 对应用例/需求：改造前单体部署图（基于 docker-compose.yml）

@startuml deployment-monolith
skinparam deployment {
    BackgroundColor #f8f9fa
    BorderColor #2c3e50
    ArrowColor #2c3e50
    NodeBorderColor #34495e
    NodeBackgroundColor #ecf0f1
    ArtifactBorderColor #2980b9
    ArtifactBackgroundColor #e8f4fd
    DatabaseBorderColor #27ae60
    DatabaseBackgroundColor #e8f8f0
}

' ========== 物理部署节点 ==========
node "Docker Compose\n(演示环境)" as DockerHost {

    ' ========== 网络配置 ==========
    rectangle "内部虚拟网络 (bridge)" as Network #fef9e7

    node "容器：Nginx\n(frontend:80)" as NginxContainer {
        artifact "Vue3 SPA 前端\n(index.html, *.js, *.css)" as FrontendSPA
        artifact "nginx.conf\n(反向代理配置)" as NginxConf
    }

    node "容器：Go Gin\n(backend:8888)" as BackendContainer {
        artifact "DanmakuStream 单体后端\n(main.go + 全部业务逻辑)" as MonolithApp
        artifact "config.yaml\n(DB连接、密钥、视频路径)" as BackendConf
        artifact "视频静态文件目录\n(/app/data)" as VideoDir
    }

    database "容器：MySQL 8.0\n(mysql:3306)" as MySQLContainer {
        database "danmakustream_schema" as DB {
            folder "users 表" as UsersTbl
            folder "videos 表" as VideosTbl
            folder "video_collections 表" as CollectionsTbl
            folder "danmakus 表" as DanmakusTbl
            folder "comments 表" as CommentsTbl
            folder "live_rooms 表" as LiveRoomsTbl
            folder "notifications 表" as NotifTbl
            folder "likes / collects / follows" as RelTbls
        }
    }

    node "容器：SRS 流媒体\n(srs:1935/1985/8081)" as SRSContainer {
        artifact "SRS 直播服务\n(RTMP/HLS/WebRTC)" as SRSServer
        artifact "直播流存储\n(live/*.flv / *.m3u8)" as LiveStreams
    }
}

' ========== 外部访问入口 ==========
actor "用户浏览器" as Browser
actor "创作者 OBS" as OBS

' ========== 协议与端口 ==========
Browser -right-> NginxContainer : HTTP/HTTPS :80\n(静态资源 + API代理)
note right on link
    前端访问路径：
    GET /               → index.html (SPA)
    GET /assets/*       → 静态资源
    /api/v1/*           → 反向代理到 backend:8888
end note

NginxContainer -down-> BackendContainer : HTTP :8888\n(Gin REST API)
note left on link
    Nginx proxy_pass 规则：
    /api/v1/* → http://backend:8888/api/v1/*
    /media/*  → http://backend:8888/media/*
end note

BackendContainer -down-> MySQLContainer : TCP :3306\n(GORM + MySQL协议)
note left on link
    DSN: root:password@tcp(mysql:3306)/danmakustream
    连接池：MaxIdle=10, MaxOpen=100
end note

BackendContainer -down-> VideoDir : 文件 I/O\n读写本地视频文件
note right on link
    视频文件挂载卷：
    video_data → /app/data
    /app/data/videos/{id}/playlist.m3u8
    /app/data/covers/{id}/cover.jpg
end note

OBS -down-> SRSContainer : RTMP推流 :1935\n(rtmp://host:1935/live/streamKey)
note right on link
    SRS RTMP配置默认端口：1935
    推流地址：rtmp://<host>:1935/live/{streamKey}
end note

BackendContainer -right-> SRSContainer : HTTP API :1985\n(SRS 回调/查询)
note right on link
    SRS HTTP API端口：1985
    用于直播状态查询、回调通知
end note

Browser ..> SRSContainer : HTTP-HLS :8081\n(直播拉流 .m3u8)
note right on link
    直播观看流地址：
    http://<host>:8081/live/{streamKey}.m3u8
end note

' ========== 容器启动依赖关系 ==========
MonolithApp .d.> DB : depends_on: service_healthy\nMySQL启动后健康检查通过才启动
FrontendSPA .d.> MonolithApp : depends_on\n后端就绪后前端才提供API

' ========== 数据卷 ==========
note bottom of MySQLContainer
    volume: mysql_data
    挂载点: /var/lib/mysql
    初始化脚本: ./scripts/init.sql
end note

note bottom of BackendContainer
    volume: video_data
    挂载点: /app/data
    配置文件挂载: ./backend/etc/config.yaml
end note

@enduml
