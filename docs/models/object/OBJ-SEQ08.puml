@startuml
title OBJ-SEQ08 UC08 会员订阅对象顺序图
autonumber
actor 用户 as U
boundary MembershipHandler as H
control MembershipService as S
database PlanRepository as PR
database OrderRepository as OR
control PaymentGateway as PG
database SubscriptionRepository as SR
U -> H: subscribe(creatorId, planId, idempotencyKey)
H -> S: createSubscriptionOrder(command)
S -> PR: findActivePlan(planId, creatorId)
PR --> S: plan/notFound
S -> S: validateBuyerAndAmount()
alt 规则校验失败
  S --> H: subscriptionRuleError
else 校验通过
  S -> OR: createOnce(order, idempotencyKey)
  OR --> S: pendingOrder
  S -> PG: pay(pendingOrder)
  PG --> S: paymentResult
  alt 支付成功且订单有效
    S -> OR: markPaidOnce(orderNo)
    S -> SR: activateOrRenew(userId, plan)
    SR --> S: activeSubscription
    S --> H: subscriptionDTO
  else 支付失败或订单失效
    S -> OR: markFailed(orderNo)
    S --> H: paymentError
  end
end
H --> U: 订阅状态/失败原因
@enduml
