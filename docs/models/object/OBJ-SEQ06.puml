@startuml OBJ-SEQ06
!include ../_theme.puml
title OBJ-SEQ06 UC06 个人视频资料库管理（对象级）
actor "用户" as user
participant "userLibraryPage: UserLibraryPage" as page
participant "libraryApi: LibraryApi" as api
participant "authMiddleware" as auth
participant "historyHandler: History*Handler / watchLaterHandler: WatchLater*Handler" as handler
participant "db: *gorm.DB" as db
participant "history: WatchHistory" as history
participant "watchLater: WatchLater" as wl
participant "userLibrary (localStorage)" as local

== SaveHistory 保存播放进度 ==
user -> page: VideoPlayer timeupdate 触发节流
page -> api: saveHistory(videoId, position)
api -> auth: PUT /api/v1/users/me/history/:videoId
auth -> handler: SaveHistoryHandler(svcCtx)
handler -> db: Select("id","duration").Where("id=? AND status=?",videoId,"approved").First(&video)
alt 视频不存在或 duration<position
  db --> handler: gorm.ErrRecordNotFound 或 position 截断到 duration
end
handler -> history: new WatchHistory{UserID, VideoID, Position: clampedPosition}
handler -> db: Clauses(OnConflict{Columns:[user_id,video_id], DoUpdates:{position,updated_at}}).Create(&history)
db --> handler: RowsAffected=1
handler --> api: gin.H{videoId, position}
api --> page: 本地缓存最新 position

== HistoryListHandler 查询历史列表 ==
user -> page: loadRecords() via kind='history'
page -> api: history({page:1,pageSize:100})
api -> auth: GET /api/v1/users/me/history
auth -> handler: HistoryListHandler(svcCtx)
handler -> db: Model(&WatchHistory{}).
              Joins("JOIN videos ON videos.id=watch_histories.video_id AND videos.deleted_at IS NULL AND videos.status=?", "approved").
              Where("watch_histories.user_id=?", userID).
              Count(&total)
handler -> db: Preload("Video.Author").
              Order("watch_histories.updated_at DESC").
              Offset/Limit.Find(&histories)
db --> handler: []WatchHistory + Nested Video.Author
handler -> handler: toLibraryRecord(video, savedAt, position) → progress = position*100/video.Duration
handler --> api: { list: []libraryRecord, total, page, pageSize }
api --> page: records.value = res.data.list

== ToggleWatchLater 切换稍后再看 ==
user -> page: 点击「稍后再看」（VideoDetailPage 或 LibraryPage）
page -> api: toggleWatchLater(videoId)
api -> auth: POST /api/v1/users/me/watch-later/:videoId
auth -> handler: ToggleWatchLaterHandler(svcCtx)
handler -> db: Select("id").Where("id=? AND status=?",videoId,"approved").First(&video)
handler -> db: Where("user_id=? AND video_id=?",uid,vid).First(&item)
alt 已存在（err==nil）
  handler -> db: Unscoped().Delete(&item)
  handler --> api: {saved:false}
else 未找到（ErrRecordNotFound）
  handler -> wl: new WatchLater{UserID, VideoID}
  handler -> db: Create(&wl)
  handler --> api: {saved:true}
end
api --> page: 切换按钮 UI 状态

== ClearHistory 清空历史（服务端） ==
user -> page: 点击清空 → ElMessageBox.confirm
page -> api: clearHistory()
api -> auth: DELETE /api/v1/users/me/history
auth -> handler: ClearHistoryHandler(svcCtx)
handler -> db: Unscoped().Where("user_id=?",uid).Delete(&WatchHistory{})
db --> handler: RowsAffected=N
handler --> api: {cleared:true}
api --> page: loadRecords() → 空列表

== Liked/Collections/Downloads 本地类 ==
user -> page: kind='liked'|'collections'|'downloads'
page -> local: getUserLibraryRecords(kind)
local --> page: JSON.parse(localStorage.getItem(STORAGE_KEYS[kind]))
user -> page: 点击删除或清空
page -> local: removeUserLibraryRecord(kind, videoId) 或 clearUserLibraryRecords(kind)
local -> local: localStorage.setItem(STORAGE_KEYS[kind], JSON.stringify(filtered))
page -> page: records.value = getUserLibraryRecords(kind)
@enduml
