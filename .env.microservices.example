# Copy to .env.microservices and pass it with --env-file for local integration.
MYSQL_ROOT_PASSWORD=local-dev-root-password
MICRO_JWT_SECRET=local-dev-jwt-secret-change-me
MICRO_INTERNAL_TOKEN=local-dev-internal-token-change-me
MICRO_SERVICE_VERSION=microservice-0.1.0
COMMIT_SHA=development
BUILD_TIME=unknown
REQUEST_TIMEOUT=2s
